{
  "name": "@toa.io/amqplib",
  "version": "0.0.0",
  "description": "An AMQP 0-9-1 client for RabbitMQ: the amqplib interface, built for throughput and a small memory footprint",
  "keywords": [
    "AMQP",
    "AMQP 0-9-1",
    "RabbitMQ",
    "amqplib"
  ],
  "homepage": "https://github.com/toa-io/amqplib#readme",
  "bugs": {
    "url": "https://github.com/toa-io/amqplib/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Artem Gurtovoi",
    "url": "https://github.com/temich"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toa-io/amqplib.git"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/harness.ts"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./callback_api": {
      "types": "./dist/callback_api.d.ts",
      "default": "./dist/callback_api.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "node tools/generate.ts && oxfmt src/defs.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:compat",
    "test:unit": "node --test 'src/**/*.test.ts'",
    "test:compat": "node compat/run.mts",
    "benchmark": "npm run build && node benchmarks/run.ts",
    "rabbitmq": "docker run -d --rm --name amqplib-rabbitmq -p 5672:5672 rabbitmq:4.2-alpine",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "check": "npm run typecheck && npm run lint && npm run fmt:check && npm test",
    "prepare": "npm run build && (husky || true)"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.6.2",
    "amqplib": "2.0.1",
    "claire": "0.4.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "husky": "^9.1.7",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
